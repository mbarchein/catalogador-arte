# Copiar a terraform.tfvars y rellenar. terraform.tfvars está en .gitignore:
# nunca se sube al repositorio, porque contiene tokens y la contraseña de la base
# de datos.
#
# Alternativa sin ficheros en disco, preferible en CI: exportar cada valor como
# variable de entorno con el prefijo TF_VAR_ (TF_VAR_supabase_access_token=...).

proyecto = "catalogador-arte"

# --- Supabase ---------------------------------------------------------------
# Token personal: https://supabase.com/dashboard/account/tokens
supabase_access_token = ""

# Identificador de la organización, visible en la URL del panel
supabase_organization_id = ""

# Contraseña de la base de datos. Déjala comentada y Terraform genera una
# aleatoria (recuperable después con `terraform output -raw db_password`).
# Solo merece la pena fijarla si ya existe una, p. ej. al importar un proyecto.
#supabase_db_password = ""

# --- Vercel -------------------------------------------------------------
# Token: https://vercel.com/account/tokens · el org id sale de `vercel whoami`
vercel_token  = ""
vercel_org_id = ""

# --- Dominio ------------------------------------------------------------------
# Token de Cloudflare con Zone:DNS:Edit sobre la zona. El dominio y el
# subdominio tienen valor por defecto (catalogo.ruizcampins.com); solo hay que
# fijarlos aquí si cambian.
cloudflare_api_token = ""

# --- Backblaze B2 ------------------------------------------------------------
# Clave maestra: B2 → Application Keys. Terraform crea con ella el bucket de
# masters y una clave acotada SIN capacidad de borrado para la funcion de firmas.
b2_application_key_id = ""
b2_application_key    = ""

# --- GitHub -----------------------------------------------------------------
github_owner      = ""
github_token      = ""
github_repository = "catalogador-arte"

# Pon a false si el repositorio ya existe en GitHub y prefieres no importarlo.
gestionar_repositorio = true
