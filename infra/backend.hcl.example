# Copiar a backend.hcl, sustituir <CLOUDFLARE_ACCOUNT_ID> y usar con:
#   terraform init -backend-config=backend.hcl
#
# El módulo bootstrap/ genera este contenido ya rellenado en su salida
# `backend_hcl` — más cómodo que editarlo a mano.
#
# Las credenciales del backend son un par de claves de acceso de R2
# (Panel de Cloudflare → R2 → Manage API tokens). Dos vías:
#
#   a) Variables de entorno antes de ejecutar terraform:
#        export AWS_ACCESS_KEY_ID=...
#        export AWS_SECRET_ACCESS_KEY=...
#
#   b) Descomentar access_key y secret_key aquí abajo. backend.hcl está en
#      .gitignore precisamente por esto: con las claves dentro es un secreto,
#      nunca se sube al repositorio.

bucket = "catalogador-arte-tfstate"
key    = "infra/terraform.tfstate"
region = "auto"

endpoints = {
  s3 = "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
}

# Par de claves de acceso de R2 (vía b; ver cabecera)
#access_key = ""
#secret_key = ""

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true

# Bloqueo mediante objeto .tflock, usando escrituras condicionales de R2.
# Verificar que funciona en la primera ejecución: si diera error, ponerlo a
# false y asumir que no hay bloqueo (aceptable con un solo operador).
use_lockfile = true
