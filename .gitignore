# Terraform: estado, credenciales y proveedores descargados.
# .terraform.lock.hcl SÍ se versiona, para fijar las versiones de los proveedores.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log
crash.*.log

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Entornos virtuales de Python (pipeline del catálogo impreso)
venv/
.venv/
env/

# Bytecode y cachés
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuración local y secretos
.env

# Copias de producción traídas con `make db-pull`. Son datos reales, con datos
# personales de coleccionistas dentro, y este repositorio es público.
volcados/
*.local.py
local_settings.py

# Base de datos local (solo si se usara SQLite para pruebas puntuales)
db.sqlite3
db.sqlite3-journal

# Ficheros subidos por la aplicación (imágenes de obra, documentos digitalizados)
media/

# Estáticos recopilados por collectstatic
staticfiles/

# Cobertura de tests
.coverage
coverage.xml
htmlcov/

# Worktrees temporales de agentes: espacio de trabajo, no contenido del proyecto
.claude/worktrees/

# Editores y sistema operativo
.idea/
.vscode/
*.swp
.DS_Store

# Corpus del banco de pruebas del detector de bordes: se genera desde un volcado
# con scripts/bordes/preparar-corpus.py. Son fotografías de obra real y este
# repositorio es público (ADR-005), igual que volcados/.
corpus-bordes/
